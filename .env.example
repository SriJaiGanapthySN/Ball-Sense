# Copy this file to ".env" and fill in your own keys. Never commit the real ".env" file.

# Gemini API key for the natural-language chat assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the default chat model
GEMINI_MODEL=gemini-3.8-flash

# CricAPI key for live match/series data (https://cricapi.com/ -> free tier)
CRICAPI_KEY=
